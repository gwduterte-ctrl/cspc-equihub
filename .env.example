NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# MySQL / MariaDB (XAMPP). 127.0.0.1 avoids IPv6 (::1) "Access denied" mismatches.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hiramhub_app
DB_PASSWORD=
DB_NAME=cspc_hiramhub
# Set to true on the hosted database (managed MySQL requires TLS); leave false for local XAMPP
DB_SSL=false

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client)
# Authorised redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Only these e-mail domains may sign up (comma separated)
ALLOWED_EMAIL_DOMAINS=cspc.edu.ph,my.cspc.edu.ph

# Mailer (SMTP) - used for notification e-mails. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CSPC EquiHub <no-reply@cspc.edu.ph>"

# First admin account (used by: npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
