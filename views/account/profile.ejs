<%- include('../partials/head', { title, shell, section }) %>
<h1>Profile</h1>
<%- include('../partials/errors', { errors }) %>
<form method="post" action="/account/profile" class="form card pad" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field"><label for="full_name">Full name</label><input id="full_name" name="full_name" maxlength="120" value="<%= p.full_name %>" required></div>
  <div class="field"><label for="email">E-mail</label><input id="email" value="<%= p.email %>" disabled></div>
  <div class="row2">
    <div class="field"><label for="user_type">I am a</label><select id="user_type" name="user_type">
      <% ['student','faculty','employee'].forEach(function (t) { %><option value="<%= t %>" <%= p.user_type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option><% }); %></select></div>
    <div class="field"><label for="id_number">ID number</label><input id="id_number" name="id_number" maxlength="30" value="<%= p.id_number || '' %>"></div>
  </div>
  <div class="field"><label for="department_id">Department</label><select id="department_id" name="department_id"><option value="">Prefer not to say</option>
    <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= p.department_id === d.id ? 'selected' : '' %>><%= d.code %> - <%= d.name %></option><% }); %></select></div>
  <button class="btn btn-sm" type="submit">Save changes</button>
</form>

<h2>Password</h2>
<%- include('../partials/errors', { errors: pwErrors }) %>
<form method="post" action="/account/profile/password" class="form card pad" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (hasPassword) { %><div class="field"><label for="current_password">Current password</label><input id="current_password" name="current_password" type="password" maxlength="128" autocomplete="current-password"></div>
  <% } else { %><p class="muted small">You signed in with Google. You can also set a password to log in with your e-mail.</p><% } %>
  <div class="row2">
    <div class="field"><label for="new_password">New password</label><input id="new_password" name="new_password" type="password" minlength="10" maxlength="128" autocomplete="new-password"></div>
    <div class="field"><label for="confirm">Confirm</label><input id="confirm" name="confirm" type="password" maxlength="128" autocomplete="new-password"></div>
  </div>
  <button class="btn btn-sm" type="submit">Save password</button>
</form>

<h2>Your data</h2>
<p class="muted small">Download everything EquiHub holds about you (RA 10173, right to access).</p>
<a class="btn btn-outline btn-sm" href="/account/my-data.json"><span class="material-icons" aria-hidden="true">download</span>Download my data</a>
<%- include('../partials/foot', { shell }) %>
