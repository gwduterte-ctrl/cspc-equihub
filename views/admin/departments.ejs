<%- include('../partials/head', { title, shell, section }) %>
<div class="toolbar"><p class="muted small">Departments own the categories and equipment shown to users.</p><a class="btn btn-sm" href="/admin/departments/new"><span class="material-icons" aria-hidden="true">add</span>Add department</a></div>
<div class="table-wrap"><table>
  <caption class="sr-only">Departments</caption>
  <thead><tr><th scope="col">Department</th><th scope="col">Code</th><th scope="col" class="num">Categories</th><th scope="col" class="num">Items</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
  <tbody><% departments.forEach(function (d) { %>
    <tr><td><div class="cell-item"><%- include('../partials/dept-logo', { code: d.code, name: d.name, logo: d.logo }) %><b><%= d.name %></b></div></td>
      <td><%= d.code %></td><td class="num"><a href="/admin/categories"><%= d.categories %></a></td><td class="num"><%= d.items %></td>
      <td class="actions"><a class="icon-btn" href="/admin/departments/<%= d.id %>/edit" aria-label="Edit <%= d.name %>"><span class="material-icons">edit</span></a>
        <form method="post" action="/admin/departments/<%= d.id %>/delete" class="inline" data-confirm="You are going to delete <%= d.name %>. This cannot be undone." data-confirm-title="Delete department?" data-confirm-yes="Yes, delete!" data-confirm-no="No, keep it."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-btn danger" type="submit" aria-label="Delete <%= d.name %>"><span class="material-icons">delete</span></button></form></td></tr>
  <% }); %></tbody>
</table></div>
<%- include('../partials/foot', { shell }) %>
