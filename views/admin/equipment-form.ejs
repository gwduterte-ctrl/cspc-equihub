<%- include('../partials/head', { title, shell, section }) %>
<%- include('../partials/errors', { errors }) %>
<% const action = e.id ? '/admin/equipment/' + e.id : '/admin/equipment'; %>
<div class="equip-form-wrap card pad">
  <form method="post" action="<%= action %>" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="cat-form-layout">

      <div class="cat-form-fields form">
        <div class="field"><label for="name">Equipment name</label><input id="name" name="name" maxlength="120" value="<%= e.name %>" required></div>
        <div class="field"><label for="category_id">Category (department)</label>
          <select id="category_id" name="category_id" required><option value="">Choose...</option>
            <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= Number(e.category_id) === c.id ? 'selected' : '' %>><%= c.dept_code %> &middot; <%= c.name %></option><% }); %></select>
          <% if (categories.length === 0) { %><small class="muted">Create a category first.</small><% } %></div>
        <div class="field"><label for="description">Description</label><textarea id="description" name="description" rows="3" maxlength="500"><%= e.description %></textarea></div>
        <div class="row2">
          <div class="field"><label for="total_qty">Total quantity</label><input id="total_qty" name="total_qty" type="number" min="0" max="9999" value="<%= e.total_qty %>" required></div>
          <div class="field"><label for="status">Status</label><select id="status" name="status"><% statuses.forEach(function (s) { %><option value="<%= s %>" <%= e.status === s ? 'selected' : '' %>><%= statusLabel[s] %></option><% }); %></select></div>
        </div>
        <label class="check"><input type="checkbox" name="featured" value="1" <%= e.featured ? 'checked' : '' %>> Show first on the homepage (featured)</label>
        <% if (e.id) { %><p class="muted small">Currently available: <b><%= e.available_qty %></b>. Changing the total adjusts availability by the same amount.</p><% } %>
        <div class="field"><label for="equip-image-input">Image <span class="muted">(JPG, PNG, WebP, max 3 MB)</span></label>
          <input id="equip-image-input" name="image" type="file" accept="image/jpeg,image/png,image/webp"></div>
        <div class="btn-row"><button class="btn btn-sm" type="submit">Save</button><a class="btn btn-ghost btn-sm" href="/admin/equipment">Cancel</a></div>
      </div>

      <div class="cat-form-preview">
        <p class="cat-preview-label">Image preview</p>
        <div class="cat-preview-box">
          <img id="equip-img-preview"
            src="<%= e.image ? '/uploads/equipment/' + e.image : '' %>"
            alt="Equipment image preview"
            <% if (!e.image) { %>hidden<% } %>>
          <span id="equip-img-placeholder" class="cat-preview-empty" <% if (e.image) { %>hidden<% } %>>
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span>No image selected</span>
          </span>
        </div>
      </div>

    </div>
  </form>
</div>
<%- include('../partials/foot', { shell }) %>
