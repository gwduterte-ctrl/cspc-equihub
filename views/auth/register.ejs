<%- include('../partials/head', { title, shell, authAlt: { text: 'Already registered?', label: 'Log in', href: '/login' } }) %>
<section class="auth-stack wide">
  <div class="auth-card">
    <img class="auth-logo" src="/img/logo-md.png" alt="CSPC EquiHub logo" width="84" height="84">
    <h1>Create your account</h1>
    <p class="auth-sub">Use your CSPC e-mail<%= domains.length ? ' (' + domains.map(function (d) { return '@' + d; }).join(' or ') + ')' : '' %>.</p>
    <%- include('../partials/errors', { errors }) %>
    <form method="post" action="/register" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="full_name">Full name</label>
        <div class="ifield"><span class="material-icons" aria-hidden="true">person_outline</span><input id="full_name" name="full_name" maxlength="120" value="<%= old.full_name || '' %>" placeholder="Enter your full name" autocomplete="name" required></div></div>
      <div class="field"><label for="email">CSPC e-mail</label>
        <div class="ifield"><span class="material-icons" aria-hidden="true">mail_outline</span><input id="email" name="email" type="email" maxlength="160" value="<%= old.email || '' %>" placeholder="name@cspc.edu.ph" autocomplete="email" required></div></div>
      <div class="row2">
        <div class="field"><label for="user_type">I am a</label>
          <select id="user_type" name="user_type" required>
            <% [['student','Student'],['faculty','Faculty'],['employee','Employee']].forEach(function (t) { %><option value="<%= t[0] %>" <%= old.user_type === t[0] ? 'selected' : '' %>><%= t[1] %></option><% }); %>
          </select></div>
        <div class="field"><label for="id_number">ID number <span class="muted">(optional)</span></label>
          <div class="ifield"><span class="material-icons" aria-hidden="true">badge</span><input id="id_number" name="id_number" maxlength="30" value="<%= old.id_number || '' %>"></div></div>
      </div>
      <div class="field"><label for="department_id">Department <span class="muted">(optional)</span></label>
        <select id="department_id" name="department_id"><option value="">Prefer not to say</option>
          <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= String(d.id) === old.department_id ? 'selected' : '' %>><%= d.code %> - <%= d.name %></option><% }); %>
        </select></div>
      <div class="row2">
        <div class="field"><label for="password">Password</label>
          <div class="ifield"><span class="material-icons" aria-hidden="true">lock_outline</span><input id="password" name="password" type="password" minlength="10" maxlength="128" placeholder="At least 10 characters" autocomplete="new-password" required>
            <button class="eye" type="button" data-toggle-pass aria-label="Show password"><span class="material-icons" aria-hidden="true">visibility</span></button></div></div>
        <div class="field"><label for="confirm">Confirm password</label>
          <div class="ifield"><span class="material-icons" aria-hidden="true">lock_outline</span><input id="confirm" name="confirm" type="password" maxlength="128" placeholder="Repeat the password" autocomplete="new-password" required>
            <button class="eye" type="button" data-toggle-pass aria-label="Show password"><span class="material-icons" aria-hidden="true">visibility</span></button></div></div>
      </div>
      <label class="check"><input type="checkbox" name="privacy" value="yes" required> I agree that EquiHub may process my name, e-mail, ID number and department to manage equipment borrowing (RA 10173). <a href="/privacy" target="_blank" rel="noopener">Read the Privacy Notice</a>.</label>
      <button class="btn btn-block" type="submit">Create account</button>
    </form>
    <a class="auth-link" href="/login">Already registered? Log in</a>
  </div>
  <% if (googleOn) { %>
  <p class="auth-or"><span>Or sign up with</span></p>
  <a class="g-btn" href="/auth/google?mode=signup"><span class="g-logo" aria-hidden="true">G</span>Sign up with CSPC Google</a>
  <% } %>
</section>
<%- include('../partials/foot', { shell }) %>
