<%# Server-rendered request pop-up (direct link / refresh / link from a notification). The requests list stays visible, blurred, behind it. %>
<% if (locals.popup) { %>
<div class="modal" data-server data-close-url="<%= popup.closeUrl %>" role="dialog" aria-modal="true" aria-label="<%= popup.r.reference_no %>">
  <a class="modal-backdrop" href="<%= popup.closeUrl %>" data-close aria-label="Close"></a>
  <div class="modal-panel" tabindex="-1">
    <a class="modal-close" href="<%= popup.closeUrl %>" data-close aria-label="Close"><span class="material-icons" aria-hidden="true">close</span></a>
    <div class="modal-body"><%- include('admin-request-body', { r: popup.r, modal: true }) %></div>
  </div>
</div>
<% } %>
